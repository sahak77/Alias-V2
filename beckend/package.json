{
  "name": "alias-backend",
  "version": "0.0.1",
  "description": "Alias backend — AI word-pack generation proxy + OTA content policy (NestJS on Fastify). Never gates gameplay.",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/e2e",
    "test:llm": "RUN_LIVE_LLM=1 vitest run test/llm"
  },
  "dependencies": {
    "@alias/contracts": "file:../packages/contracts",
    "@anthropic-ai/sdk": "0.100.1",
    "@aws-sdk/client-s3": "3.1061.0",
    "@fastify/static": "8.3.0",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@nestjs/platform-fastify": "11.1.24",
    "@nestjs/swagger": "11.4.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/auto-instrumentations-node": "0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@sentry/node": "9.47.1",
    "@upstash/ratelimit": "2.0.8",
    "@upstash/redis": "1.38.0",
    "drizzle-orm": "0.45.2",
    "nestjs-pino": "4.6.1",
    "nestjs-zod": "5.4.0",
    "pg": "8.21.0",
    "pg-boss": "12.18.2",
    "pino": "9.14.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.1",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.24",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.15.40",
    "@types/node": "24.13.0",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "@vitest/coverage-v8": "4.1.8",
    "chokidar": "5.0.0",
    "drizzle-kit": "0.31.10",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "msw": "2.14.6",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.3",
    "supertest": "7.2.2",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1",
    "unplugin-swc": "1.5.9",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}
