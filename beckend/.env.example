# ── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (Postgres 17) ────────────────────────────────────────────────────
# Required at boot. Matches docker-compose defaults.
DATABASE_URL=postgres://alias:alias@localhost:5432/alias

# ── Upstash Redis (rate-limit + spend-cap counters) ───────────────────────────
# Optional until the generation proxy is implemented.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Cloudflare R2 (OTA content policy + packs, S3-compatible) ─────────────────
# Optional until the content-policy read path is implemented.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# ── LLM provider (Anthropic Claude Haiku 4.5) ─────────────────────────────────
# Optional until the generation proxy is implemented.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_MONTHLY_BUDGET=50

# ── Observability (backstage-only; never user-facing) ─────────────────────────
# All optional. theme / tokens / BYO-keys must be redacted before export.
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASEURL=https://cloud.langfuse.com

# ── Tests ─────────────────────────────────────────────────────────────────────
RUN_LIVE_LLM=0

# ── Mobile-app hints (consumed by application, NOT by this server) ───────────────
# EXPO_PUBLIC_API_URL (dev)     = http://localhost:3000
# EXPO_PUBLIC_API_URL (staging) = https://<your-staging>.up.railway.app
# EXPO_PUBLIC_API_URL (prod)    = https://api.<your-domain>
